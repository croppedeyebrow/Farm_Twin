# =============================================================================
# Compose / 컨테이너용 환경변수 예제 (1단계 Day 3)
# 사용: 저장소 루트에서 `cp .env.example .env`
#
# DATABASE_URL 의 호스트명은 Compose 서비스 이름 `db` 이다.
# 호스트 OS에서 API를 직접 띄울 때는 backend/.env.example 을 쓰고
# 127.0.0.1:15432 로 접속한다 (compose 가 DB 포트를 publish).
# =============================================================================

POSTGRES_DB=farmtwin
POSTGRES_USER=farmtwin
POSTGRES_PASSWORD=farmtwin
DATABASE_URL=postgresql+asyncpg://farmtwin:farmtwin@db:5432/farmtwin

# Local host development (API outside Docker) uses backend/.env.example instead:
# DATABASE_URL=postgresql+asyncpg://farmtwin:farmtwin@127.0.0.1:15432/farmtwin
